{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "university-agent",
  "version": "0.3.6",
  "description": "터틀넥: 대학생활 관리와 읽은 수업자료 기반 대화형 학습보조",
  "author": {
    "name": "K-Lunatic"
  },
  "repository": "https://github.com/K-Lunatic/CS2026-Hackerton",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "터틀넥",
        "shortDescription": "수업자료 기반 시험지와 AI 채점",
        "longDescription": "안녕하세요! 터틀넥입니다 🎓 과제 관리, 문제 풀이, 진행 상황 저장, 수업자료 요약과 연습문제 생성을 도와드려요.",
        "developerName": "K-Lunatic",
        "category": "Productivity",
        "capabilities": [
          "Read local academic data",
          "Manage local assignments",
          "Create study materials from local course files"
        ],
        "composerIcon": "./assets/turtleneck.png",
        "logo": "./assets/turtleneck.png",
        "defaultPrompt": [
          "이번 주 미제출 과제 알려줘",
          "이 문제 절반만 풀어줘",
          "진행 상황 저장해줘",
          "이 자료로 공부해줘"
        ]
      }
    }
  }
}
