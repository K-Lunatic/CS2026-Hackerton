            }
          },
          {
            "name": "unfinished",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of student records",
            "content": {
              "application/json": {
