          }
        }
      }
    },
    "/v1/sync": {
      "get": {
        "operationId": "getSyncStatus",
        "summary": "Read sync status, available sections, last successful update and errors.",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          }
        }
      },
      "post": {
        "operationId": "startSync",
        "summary": "Refresh academic data using the server-side TLS login session. Returns immediately; poll getSyncStatus.",
        "responses": {
          "202": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/v1/disconnect": {
      "post": {
        "operationId": "disconnectAccount",
        "summary": "Revoke this student connection and all its tokens. Stored academic records remain; ask the operator for deletion.",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          }
        },
        "x-openai-isConsequential": true
      }
    }
  }
}
